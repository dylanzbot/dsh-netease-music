{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "lib",
    "rootDir": "src",
    "outDir": "lib",
    "types": [
      "node",
      "react"
    ],
    "noUncheckedSideEffectImports": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
